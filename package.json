{
  "name": "timemaster-v2",
  "version": "0.1.3",
  "description": "时间大师 V2 — 日历、待办、四象限、专注、主任务、费用台账与桌面小组件",
  "author": "Ray",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "./runtime/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigelephant-code/LiteCal.git"
  },
  "bugs": {
    "url": "https://github.com/bigelephant-code/LiteCal/issues"
  },
  "homepage": "https://github.com/bigelephant-code/LiteCal#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dev": "npm run ensure:electron && electron .",
    "start": "npm run ensure:electron && electron .",
    "check": "node scripts/verify-runtime.mjs",
    "build": "npm run check",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run ensure:electron && npm run icon && npm run check && electron-builder --win --x64",
    "dist:dir": "npm run ensure:electron && npm run icon && npm run check && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.timemaster.v2",
    "productName": "时间大师 V2",
    "artifactName": "TimeMasterV2-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "runtime/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "TimeMasterV2"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "时间大师 V2",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
