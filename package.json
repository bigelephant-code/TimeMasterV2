{
  "name": "timemaster-v2",
  "version": "0.1.8",
  "description": "时间大师 — 日历、待办、四象限、专注、主任务、费用台账与桌面小组件",
  "author": "Ray",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigelephant-code/TimeMasterV2.git"
  },
  "bugs": {
    "url": "https://github.com/bigelephant-code/TimeMasterV2/issues"
  },
  "homepage": "https://github.com/bigelephant-code/TimeMasterV2#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dev": "npm run ensure:electron && electron-vite dev",
    "start": "npm run ensure:electron && electron-vite preview",
    "check:reference": "node scripts/verify-runtime.mjs",
    "test": "node --test tests/contracts.test.mjs tests/task-time.test.mjs tests/expense-categories.test.mjs",
    "check": "npm run check:reference && npm test && npm run build && npm run verify:build",
    "build": "electron-vite build && node scripts/harden-built-csp.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run ensure:electron && npm run icon && npm run check && electron-builder --win --x64",
    "dist:dir": "npm run ensure:electron && npm run icon && npm run check && electron-builder --win --x64 --dir",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs"
  },
  "dependencies": {
    "lunar-javascript": "1.7.7",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.timemaster.v2",
    "productName": "时间大师",
    "artifactName": "TimeMaster-Setup-${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "LICENSES/**/*",
      "PRIVACY.md"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "TimeMaster"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "时间大师",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
